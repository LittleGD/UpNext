<?xml version="1.0" encoding="utf-8"?>
<!-- 시스템 스플래시(API 31+ 및 core-splashscreen 호환 경로)의 아이콘 자리에 넣는 완전 투명 드로어블.
     windowSplashScreenAnimatedIcon 을 비워 두면 런처 아이콘이 뜨므로 명시적으로 투명 shape 를 지정한다.
     @android:color/transparent(ColorDrawable) 대신 shape 를 쓴 이유: 아이콘 뷰는 Drawable 을
     고정 크기 영역에 스케일해 그리는데, 고유 크기를 가진 정식 Drawable 이 OEM 별 처리 편차에 가장 안전하다. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <size
        android:width="108dp"
        android:height="108dp" />
</shape>
