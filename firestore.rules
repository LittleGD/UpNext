rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSignedInUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // 유저 프로필 / progress — 본인 것만 read/write.
    match /users/{userId} {
      allow read, write: if isSignedInUser(userId);
    }

    // iOS retention Phase 4 — 1:1 duo streak experiment.
    //   solo streak 와 독립된 작은 실험 데이터라 /users/{uid}.progress 와 분리한다.
    match /duos/{duoId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['memberIds', 'memberNames', 'checkIns', 'createdAt', 'updatedAt'])
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() == 1
        && request.resource.data.memberIds[0] == request.auth.uid
        && request.resource.data.memberNames is map
        && request.resource.data.memberNames[request.auth.uid] is string
        && request.resource.data.memberNames[request.auth.uid].size() > 0
        && request.resource.data.memberNames[request.auth.uid].size() <= 40
        && request.resource.data.checkIns is map
        && request.resource.data.checkIns[request.auth.uid] is list
        && request.resource.data.createdAt is int
        && request.resource.data.updatedAt is int;

      // update 는 3개 분기로 한정 — 그 외 모두 거부.
      //
      //   A) 솔로(size 1) → 듀오(size 2) join: 기존 멤버 보존 + 자신 추가만.
      //      → 임의 사용자가 duoId 만 알고 솔로를 강탈하는 케이스 차단.
      //   B) 기존 멤버 update: memberIds 불변 + checkIns/memberNames 의 *본인 키만* mutate.
      //      → 파트너의 checkIns/displayName 위조 차단 (diff().affectedKeys() 로).
      //   C) self leave: 본인을 memberIds 에서 제외 + 본인 키 정리. 나머지 멤버 데이터 보존.
      //
      //   공통: createdAt 불변, updatedAt 은 int, checkIns/memberNames 는 map 이고
      //   size <= 2, 허용 키만 (hasOnly).
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['memberIds', 'memberNames', 'checkIns', 'createdAt', 'updatedAt'])
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is int
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() <= 2
        && request.resource.data.memberNames is map
        && request.resource.data.memberNames.size() <= 2
        && request.resource.data.checkIns is map
        && request.resource.data.checkIns.size() <= 2
        && (
          // A) join — 기존 솔로 멤버 보존 + 신규 멤버 자신만 추가.
          (
            resource.data.memberIds.size() == 1
            && request.resource.data.memberIds.size() == 2
            && resource.data.memberIds[0] in request.resource.data.memberIds
            && request.auth.uid in request.resource.data.memberIds
            && request.auth.uid != resource.data.memberIds[0]
            && request.resource.data.memberNames[request.auth.uid] is string
            && request.resource.data.memberNames[request.auth.uid].size() > 0
            && request.resource.data.memberNames[request.auth.uid].size() <= 40
            && request.resource.data.checkIns.diff(resource.data.checkIns).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([request.auth.uid])
          )
          // B) 기존 멤버 — memberIds 불변, 본인 키만 변경.
          || (
            request.auth.uid in resource.data.memberIds
            && request.resource.data.memberIds == resource.data.memberIds
            && request.resource.data.checkIns.diff(resource.data.checkIns).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([request.auth.uid])
          )
          // C) self leave — 본인 제거 + 본인 키 청소. 다른 멤버 데이터 그대로.
          || (
            request.auth.uid in resource.data.memberIds
            && !(request.auth.uid in request.resource.data.memberIds)
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() - 1
            && request.resource.data.checkIns.diff(resource.data.checkIns).affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.memberNames.diff(resource.data.memberNames).affectedKeys().hasOnly([request.auth.uid])
          )
        );

      allow delete: if false;
    }

    match /duoInvites/{code} {
      allow read: if signedIn();

      allow create: if signedIn()
        && code.matches('^[A-Z2-9]{6}$')
        && request.resource.data.keys().hasOnly(['code', 'duoId', 'createdBy', 'createdAt', 'expiresAt', 'status'])
        && request.resource.data.code == code
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.duoId is string
        && request.resource.data.createdAt is int
        && request.resource.data.expiresAt is int
        && request.resource.data.expiresAt > request.resource.data.createdAt
        && request.resource.data.status == 'open';

      // update 는 2개 분기로 한정 — 그 외 모두 거부.
      //   - createdBy: 자기 invite 를 자유롭게 close/joined 마킹.
      //   - 비-createdBy(코드로 join 하는 사용자): open → joined 전환만.
      //   → 임의 사용자가 다른 사람 invite 를 closed 로 만드는 griefing 차단.
      //   공통: 모든 불변 필드 보존, status 는 알려진 enum 만.
      allow update: if signedIn()
        && resource.data.status == 'open'
        && request.resource.data.keys().hasOnly(['code', 'duoId', 'createdBy', 'createdAt', 'expiresAt', 'status'])
        && request.resource.data.code == resource.data.code
        && request.resource.data.duoId == resource.data.duoId
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.expiresAt == resource.data.expiresAt
        && request.resource.data.status in ['open', 'joined', 'closed']
        && (
          request.auth.uid == resource.data.createdBy
          || (
            request.auth.uid != resource.data.createdBy
            && request.resource.data.status == 'joined'
          )
        );

      allow delete: if false;
    }

    // Phase 11c — 주간 악몽 던전 리더보드.
    //   읽기: 전체 공개 (익명 포함) — 순위 탐색은 게스트도 가능.
    //   쓰기: 자기 entry 만 (uid 일치 필수 + 로그인 필수).
    //
    // Phase 11c R4 보안 강화:
    //   - weekId 는 ISO 주간 format (예: "2026-W16") 만 허용 → path injection 차단.
    //   - 허용 필드 allowlist (hasOnly) → 임의 필드 삽입으로 doc 오염 방지.
    //   - displayName 길이 40 제한 → 거대 string 으로 리더보드 조회 DoS 차단.
    //   - classType 은 알려진 enum 만 허용.
    //   - score 공식 기반 상한 검증 — floorsCleared*100 + completion(2000) +
    //     timeBonus(≤440, BASE_EXPEDITION_TIME 220 × 2) + heroLv²×2 보다 작거나 같아야.
    //     악성 유저가 score 를 임의로 올려도 수학적으로 가능한 최대값 이내로 제한.
    //     완전한 cheat 방지는 Cloud Function 재계산 단계 (추후) 에서.
    match /weekly-leaderboard/{weekId}/entries/{uid} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.uid == uid
        && weekId.matches('^[0-9]{4}-W[0-9]{2}$')
        // 필드 allowlist — 허용된 키만 존재.
        && request.resource.data.keys().hasOnly(['uid', 'displayName', 'score', 'floorsCleared', 'heroLevel', 'classType', 'clearedAt'])
        && request.resource.data.keys().hasAll(['uid', 'displayName', 'score', 'floorsCleared', 'heroLevel', 'clearedAt'])
        && request.resource.data.uid == uid
        // displayName 검증
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40
        // score 검증 — 수학적 최대값 이내.
        && request.resource.data.score is number
        && request.resource.data.score >= 0
        && request.resource.data.floorsCleared is number
        && request.resource.data.floorsCleared >= 0
        && request.resource.data.floorsCleared <= 30
        && request.resource.data.heroLevel is number
        && request.resource.data.heroLevel >= 1
        && request.resource.data.heroLevel <= 500
        // 공식 상한: floors*100 + 2000 (완주 보너스) + 440 (time max) + heroLv²×2.
        // Lv500 기준: 30*100 + 2000 + 440 + 500000 = 505,440. 실제 cap.
        && request.resource.data.score <=
          (request.resource.data.floorsCleared * 100)
          + 2000
          + 440
          + (request.resource.data.heroLevel * request.resource.data.heroLevel * 2)
        // classType — null 또는 알려진 enum.
        && (
          !('classType' in request.resource.data.keys())
          || request.resource.data.classType == null
          || request.resource.data.classType in [
            'warrior', 'mage', 'monk', 'druid',
            'bard', 'chronomancer', 'priest', 'illusionist'
          ]
        )
        // clearedAt — 2024-01-01 이후 (음수/0 차단).
        && request.resource.data.clearedAt is int
        && request.resource.data.clearedAt >= 1704067200000;
    }
  }
}
