# UpNext Android 서명 자격 증명 템플릿
#
# 사용법:
#   1) 이 파일을 `keystore.properties` 로 복사
#   2) 실제 값으로 채운 뒤 저장
#   3) `keystore.properties` 는 .gitignore 에 포함되어 있으므로 절대 커밋되지 않음
#
# 대안(CI 환경):
#   keystore.properties 대신 아래 환경 변수로도 동일하게 동작:
#     UPNEXT_KEYSTORE_FILE      — .keystore 파일 절대/상대 경로
#     UPNEXT_KEYSTORE_PASSWORD  — 키스토어 비밀번호
#     UPNEXT_KEY_ALIAS          — 키 별칭
#     UPNEXT_KEY_PASSWORD       — 키 비밀번호
#
# 네 값 중 하나라도 없으면 release 빌드는 서명되지 않음 (디버그 빌드는 영향 없음).

storeFile=../android.keystore
storePassword=your-keystore-password-here
keyAlias=upnext
keyPassword=your-key-password-here
