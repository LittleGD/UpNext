    "title": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2인 불꽃 초대"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Duo Flame invitation"
