          "stringUnit": {
            "state": "translated",
            "value": "友だちと今日の炎を灯そう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "和朋友一起点亮今天的火焰。"
