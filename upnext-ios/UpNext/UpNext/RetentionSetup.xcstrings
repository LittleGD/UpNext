    "홈 화면의 빈 곳을 길게 누르기": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈 화면의 빈 곳을 길게 누르기"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and hold an empty area of the Home Screen"
          }
        },
        "ja": {
