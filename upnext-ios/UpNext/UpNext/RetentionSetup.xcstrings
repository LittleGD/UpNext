{
  "sourceLanguage": "ko",
  "strings": {
    "내일도 이어가요": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내일도 이어가요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep it going tomorrow"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明日も続けよう"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明天继续"
          }
        }
      }
    },
    "눈에 보이면 더 쉬워요": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "눈에 보이면 더 쉬워요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep it in sight"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目に入ると、続けやすい"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看得见，更容易坚持"
          }
        }
      }
    },
    "닫기": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "닫기"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閉じる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭"
          }
        }
      }
    },
    "내일 만날 시간, 정했어요": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내일 만날 시간, 정했어요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See you tomorrow"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明日の時間が決まりました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "明天见面的时间定好了"
          }
        }
      }
    },
    "홈 화면에 자리 잡았어요": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈 화면에 자리 잡았어요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your widget is in place"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面に追加できました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小组件已添加到主屏幕"
          }
        }
      }
    },
    "알림을 다시 켜볼까요?": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림을 다시 켜볼까요?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn reminders back on"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知をもう一度オンに"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新开启提醒"
          }
        }
      }
    },
    "첫 실천 완료!\n내일은 언제 만날까요?": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 실천 완료!\n내일은 언제 만날까요?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "First challenge complete!\nWhen works for tomorrow?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "初めてのチャレンジ達成！\n明日は何時にしましょう？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一次挑战完成！\n明天几点提醒你？"
          }
        }
      }
    },
    "두 번째 실천도 완료!\n홈 화면에 꺼내둘까요?": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 번째 실천도 완료!\n홈 화면에 꺼내둘까요?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two challenges complete!\nKeep the next one in sight."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2つ目のチャレンジも達成！\nホーム画面に置きませんか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第二次挑战也完成了！\n把挑战放到主屏幕吧"
          }
        }
      }
    },
    "위젯을 놓을\n자리를 만들어요": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위젯을 놓을\n자리를 만들어요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make room\nfor your widget"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィジェットを置く\n場所を作りましょう"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为小组件\n腾出位置"
          }
        }
      }
    },
    "UpNext를 찾아\n위젯을 골라요": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "UpNext를 찾아\n위젯을 골라요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find UpNext.\nChoose your widget."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "UpNextを探して\nウィジェットを選びます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找到 UpNext\n选择小组件"
          }
        }
      }
    },
    "이제 홈 화면에서\n직접 추가해보세요": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이제 홈 화면에서\n직접 추가해보세요"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now add it\nto your Home Screen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次はホーム画面で\n追加してみましょう"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在到主屏幕\n实际添加吧"
          }
        }
      }
    },
    "선택한 시간에 하루 한 번 알려드릴게요. 설정에서 언제든 바꿀 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 시간에 하루 한 번 알려드릴게요. 설정에서 언제든 바꿀 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You’ll get one reminder a day at your chosen time. Change it anytime in Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだ時間に1日1回お知らせします。設定でいつでも変更できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天会在你选择的时间提醒一次。随时可以在设置中更改。"
          }
        }
      }
    },
    "오늘의 챌린지를 바로 확인하고, 위젯을 눌러 UpNext로 돌아올 수 있어요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘의 챌린지를 바로 확인하고, 위젯을 눌러 UpNext로 돌아올 수 있어요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See today’s challenge at a glance. Tap the widget to return to UpNext."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のチャレンジをひと目で確認。タップするとUpNextに戻れます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一眼查看今天的挑战。轻点小组件即可返回 UpNext。"
          }
        }
      }
    },
    "실천하기 편한 시간을 골라주세요. 하루 한 번, 오늘의 챌린지를 알려드릴게요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실천하기 편한 시간을 골라주세요. 하루 한 번, 오늘의 챌린지를 알려드릴게요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a time that fits your day. We’ll remind you of your challenge once a day."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り組みやすい時間を選んでください。今日のチャレンジを1日1回お知らせします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择方便行动的时间。每天提醒你一次今天的挑战。"
          }
        }
      }
    },
    "앱을 열지 않아도 오늘 할 일이 보여요. 아래 화면으로 추가하는 방법을 연습해봐요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 열지 않아도 오늘 할 일이 보여요. 아래 화면으로 추가하는 방법을 연습해봐요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See your challenge without opening the app. Try adding a widget in the practice screen below."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリを開かなくても今日やることが見えます。下の画面で追加の手順を練習しましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不用打开应用也能看到今天的任务。在下方练习如何添加小组件。"
          }
        }
      }
    },
    "홈 화면을 길게 누른 다음, 왼쪽 위 ‘편집’에서 ‘위젯 추가’를 선택해요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈 화면을 길게 누른 다음, 왼쪽 위 ‘편집’에서 ‘위젯 추가’를 선택해요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and hold the Home Screen. Tap Edit at the top left, then Add Widget."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面を長押しし、左上の「編集」から「ウィジェットを追加」を選びます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "长按主屏幕，轻点左上角“编辑”，再选择“添加小组件”。"
          }
        }
      }
    },
    "위젯 목록에서 UpNext를 검색하고, 원하는 크기를 고른 뒤 ‘위젯 추가’를 눌러요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위젯 목록에서 UpNext를 검색하고, 원하는 크기를 고른 뒤 ‘위젯 추가’를 눌러요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search for UpNext in the widget gallery. Choose a size, then tap Add Widget."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウィジェットの一覧でUpNextを検索し、サイズを選んで「ウィジェットを追加」をタップします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在小组件列表中搜索 UpNext，选择尺寸，然后轻点“添加小组件”。"
          }
        }
      }
    },
    "홈 화면으로 나가 아래 순서대로 추가해주세요. 돌아오면 설치 여부를 확인할게요.": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈 화면으로 나가 아래 순서대로 추가해주세요. 돌아오면 설치 여부를 확인할게요."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to your Home Screen and follow these steps. We’ll check for your widget when you return."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面に戻り、次の手順で追加してください。戻ってきたら追加できたか確認します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "返回主屏幕，按以下步骤添加。你回来后，我们会检查是否已添加。"
          }
        }
      }
    },
