    },
    "uphero.flavor.mst.0.opt1.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경외만 하고 지나간다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only bow and pass"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "畏敬の念だけ抱き通り過ぎる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅敬而远之"
          }
        }
      }
    },
    "uphero.flavor.mst.0.opt1.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예의를 표하고 조심히 비켜간다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Showed respect and stepped carefully around it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "礼を尽くし、慎重に避けて通る。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恭敬致意,小心绕行。"
          }
        }
      }
    },
    "uphero.flavor.mst.0.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바위에 새겨진 낯선 표식이 깜빡인다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A strange mark flickers on a boulder."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "岩に刻まれた見知らぬ紋章が明滅する。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "岩石上刻着闪烁不定的陌生符号。"
          }
        }
      }
    },
    "uphero.flavor.mst.1.opt0.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손을 넣어본다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reach inside"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "手を差し入れる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "伸手探入"
          }
        }
      }
    },
    "uphero.flavor.mst.1.opt0.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "반대편에서 뭔가 쥐었다. 반짝이는 돌."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grasped something on the other side — a shining stone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "向こう側で何かを掴んだ。煌めく石。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在另一端握住了什么——一颗闪亮的石头。"
          }
        }
      }
    },
    "uphero.flavor.mst.1.opt0.out1.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "균열이 좁아지며 팔을 조인다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rift narrowed, crushing the arm."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "亀裂が狭まり、腕を締めつける。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "裂隙收缩,夹住了手臂。"
          }
        }
      }
    },
    "uphero.flavor.mst.1.opt0.out2.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다음 층 입구로 흘러 나왔다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spilled out at the next floor's entrance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の階の入口へ流れ出た。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "顺势被卷入下一层入口。"
          }
        }
      }
    },
    "uphero.flavor.mst.1.opt1.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "멀리 돌아간다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go around"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きく迂回する"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远远绕开"
          }
        }
      }
    },
    "uphero.flavor.mst.1.opt1.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "균열을 피해 우회한다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detoured safely around the rift."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "亀裂を避けて回り込む。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "避开裂隙,改道而行。"
          }
        }
      }
    },
    "uphero.flavor.mst.1.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공기가 비틀린다. 공간에 가느다란 균열이 있다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The air warps. A thin rift cuts through space."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空気が歪む。空間に細い亀裂がある。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空气扭曲——空间中有一道细细的裂隙。"
          }
        }
      }
    },
    "uphero.flavor.mst.2.opt0.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거꾸로 쥔다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold it upside-down"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "逆手に握る"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "反向握住"
          }
        }
      }
    },
    "uphero.flavor.mst.2.opt0.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간이 되돌아와 상처가 아물었다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time rewound and wounds closed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時が巻き戻り、傷が癒えた。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时间倒流,创伤愈合。"
          }
        }
      }
    },
    "uphero.flavor.mst.2.opt0.out1.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "너무 많이 되돌렸다. 기운이 빠진다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rewound too far — strength drains away."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "戻しすぎた。気力が抜けていく。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "倒得太多,气力流失。"
          }
        }
      }
    },
    "uphero.flavor.mst.2.opt0.out2.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자신의 미래를 보았다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Caught a glimpse of the hero's future."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自らの未来を見た。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "窥见了自己的未来。"
          }
        }
      }
    },
    "uphero.flavor.mst.2.opt1.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그냥 둔다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave it alone"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのままにする"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不去动它"
          }
        }
      }
    },
    "uphero.flavor.mst.2.opt1.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손대지 않는 것이 현명하다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wise not to touch it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "触れないのが賢明だ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不去触碰才是明智之举。"
          }
        }
      }
    },
    "uphero.flavor.mst.2.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거꾸로 흐르는 모래시계가 공중에 떠 있다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An hourglass flows backward in midair."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "逆さまに流れる砂時計が宙に浮かんでいる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一只逆向流动的沙漏悬浮在空中。"
          }
        }
      }
    },
    "uphero.flavor.mst.3.opt0.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "들여다본다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look inside"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "覗き込む"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "凝视镜中"
          }
        }
      }
    },
    "uphero.flavor.mst.3.opt0.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자신의 약점이 드러났다. 극복한다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaws revealed — and overcome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自らの弱点が露わに。それを克服する。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "弱点浮现,并被克服。"
          }
        }
      }
    },
    "uphero.flavor.mst.3.opt0.out1.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어두운 자아가 튀어나와 공격한다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A dark self leapt out and struck."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暗き自我が飛び出し襲いかかる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阴暗的自我跃出发动攻击。"
          }
        }
      }
    },
    "uphero.flavor.mst.3.opt0.out2.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거울 속에 숨겨진 통로가 보인다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A hidden passage appeared inside the mirror."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鏡の中に隠された通路が見える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "镜中浮现出一条隐藏通道。"
          }
        }
      }
    },
    "uphero.flavor.mst.3.opt1.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "등을 돌린다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn away"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "背を向ける"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "背过身去"
          }
        }
      }
    },
    "uphero.flavor.mst.3.opt1.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보지 않는 것이 나을 때도 있다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some things are better left unseen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見ぬが花ということもある。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有些事不看反而更好。"
          }
        }
      }
    },
    "uphero.flavor.mst.3.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길 한복판에 놓인 빈 거울. 아무것도 비치지 않는다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An empty mirror stands in the path. It reflects nothing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "道の真ん中に置かれた空の鏡。何も映らない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "路中央立着一面空镜——映不出任何影像。"
          }
        }
      }
    },
    "uphero.flavor.mst.4.opt0.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체력을 내어준다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sacrifice HP"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HP を捧げる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "献出 HP"
          }
        }
      }
    },
    "uphero.flavor.mst.4.opt0.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체력이 많이 빠져나갔다. 대신 주머니가 두둑하다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "HP drained heavily — but the purse grew fat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HP は大きく削がれたが、懐は重くなった。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "HP 大幅流失——钱袋却鼓了起来。"
          }
        }
      }
    },
    "uphero.flavor.mst.4.opt1.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간을 내어준다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sacrifice time"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間を捧げる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "献出时间"
          }
        }
      }
    },
    "uphero.flavor.mst.4.opt1.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "긴 시간이 순식간에 지나갔지만 경험은 남는다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long hours flashed past, but the experience remained."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長い時が一瞬で過ぎたが、経験は残る。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "漫长岁月一瞬而过,经验却留了下来。"
          }
        }
      }
    },
    "uphero.flavor.mst.4.opt2.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거절한다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refuse"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拒絶する"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拒绝"
          }
        }
      }
    },
    "uphero.flavor.mst.4.opt2.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목소리가 사라진다."
