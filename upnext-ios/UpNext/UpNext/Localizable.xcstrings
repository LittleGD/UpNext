        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "酒杯相碰之声响起。"
          }
        }
      }
    },
    "uphero.narrative.soc.6": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "광대의 웃음이 공허하다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A jester's laugh rang hollow in the square."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "道化師の笑い声がうつろに響く。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小丑的笑声空洞而散。"
          }
        }
      }
    },
    "uphero.narrative.soc.7": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "낯선 이의 시선이 느껴진다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A stranger's gaze settled on the hero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見知らぬ者の視線を感ずる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "陌生人的目光落在身上。"
          }
        }
      }
    },
    "uphero.narrative.soc.8": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "축제의 장막이 보인다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The awnings of a festival came into view."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "祭りの帳が見えてくる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "节庆的帷幕映入眼帘。"
          }
        }
      }
    },
    "uphero.narrative.soc.9": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음유시인의 이야기가 들린다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bard's tale drifted on the breeze."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "吟遊詩人の物語が耳に届く。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "吟游诗人的故事随风而至。"
          }
        }
      }
    },
    "uphero.narrative.trd.0": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공간이 뒤틀린다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The space itself warped and twisted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空間が捻じ曲がる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空间扭曲变形。"
          }
        }
      }
    },
    "uphero.narrative.trd.1": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "색이 계속 바뀐다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Colors kept shifting in impossible ways."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "色が絶えず移ろい続ける。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "色彩不停地变换。"
          }
        }
      }
    },
    "uphero.narrative.trd.2": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이해할 수 없는 문양이 떠다닌다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glyphs drifted past, unreadable."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "理解不能な紋様が漂う。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "难以辨识的纹样漂浮游移。"
          }
        }
      }
    },
    "uphero.narrative.trd.3": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "감각이 왜곡된다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The hero's senses bent out of true."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "感覚が歪んでゆく。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "感官被扭曲失真。"
          }
        }
      }
    },
    "uphero.narrative.trd.4": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네온 불빛이 깜빡인다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Neon lights flickered and stuttered."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネオンの光が瞬きを繰り返す。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "霓虹灯光闪烁不定。"
          }
        }
      }
    },
    "uphero.narrative.trd.5": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음향이 왜곡되어 들린다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sounds arrived distorted and wrong."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声が歪んで聞こえる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音响扭曲变形传来。"
          }
        }
      }
    },
    "uphero.narrative.trd.6": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "벽이 거울처럼 반사한다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The walls reflected like liquid mirrors."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "壁が鏡のように景色を映す。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "墙面如镜般反射。"
          }
        }
      }
    },
    "uphero.narrative.trd.7": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "픽셀이 흩어지며 재조합된다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pixels scattered, then reassembled."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画素が散り、また組み直される。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像素散落后又重新组合。"
          }
        }
      }
    },
    "uphero.narrative.trd.8": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이상한 노래가 머릿속에 남는다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A strange song lodged itself in the hero's mind."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "奇妙なる歌が頭に残る。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一首奇异的歌在脑中挥之不去。"
          }
        }
      }
    },
    "uphero.narrative.trd.9": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "중력이 살짝 약해진다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravity grew a little weaker here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重力がわずかに弱まる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重力似乎微微减弱。"
          }
        }
      }
    },
    "uphero.narrative.wel.0": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "따뜻한 김이 피어오른다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm steam rose in curling threads."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "暖かき湯気が立ち昇る。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "温暖的水汽袅袅升起。"
          }
        }
      }
    },
    "uphero.narrative.wel.1": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온천 물소리가 평화롭다."
