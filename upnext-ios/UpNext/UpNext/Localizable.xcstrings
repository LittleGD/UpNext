    "uphero.flavor.trd.4.opt0.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왜곡 지점을 찾아낸다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spot the distortion"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "歪みの地点を見つけ出す"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找出扭曲之处"
          }
        }
      }
    },
    "uphero.flavor.trd.4.opt0.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왜곡 속 비밀 룬이 깨어나 마나를 내어주었다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The secret rune within the distortion awakened and yielded its mana."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "歪みの中に潜んでいた秘密のルーンが目覚め、マナを授けてくれた。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扭曲深处的秘符苏醒,赐予了魔力。"
          }
        }
      }
    },
    "uphero.flavor.trd.4.opt1.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "룬을 건드리지 않고 돌아간다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave the runes untouched"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルーンに触れずに引き返す"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不碰符文,绕道离开"
          }
        }
      }
    },
    "uphero.flavor.trd.4.opt1.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "룬이 잠잠해지며 희미한 반향만 남는다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The runes quiet down, leaving only a faint echo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルーンは静まり、かすかな残響だけが残った。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "符文归于沉寂,只留下淡淡的回响。"
          }
        }
      }
    },
    "uphero.flavor.trd.4.opt1.out1.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "벽 틈새에서 떨어진 마나 조각을 주웠다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You picked up a shard of mana that had fallen from a crack in the wall."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "壁の隙間から落ちたマナの欠片を拾い上げた。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从墙缝中拾起了一片掉落的魔力碎片。"
          }
        }
      }
    },
    "uphero.flavor.trd.4.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고대 룬 벽에 미세한 왜곡 하나가 숨어 일렁인다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A tiny distortion shimmers, hidden among the ancient runes on the wall."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古代のルーンの壁に、かすかな歪みがひとつ潜んで揺らいでいる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "古老的符文墙上,有一道细微的扭曲隐隐晃动。"
          }
        }
      }
    },
    "uphero.flavor.trd.5.opt0.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "좌우로 피하며 별빛을 모은다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodge left and right, gather the starlight"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "左右に避けながら星の光を集める"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "左右闪避,收集星光"
          }
        }
      }
    },
    "uphero.flavor.trd.5.opt0.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "별빛 소나기를 가르며 천상의 보상을 손에 넣었다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You cut through the stellar shower and claimed a heavenly reward."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "流星のシャワーをかいくぐり、天上の報酬を手に入れた。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "穿越流星雨,夺得了天界的奖赏。"
          }
        }
      }
    },
    "uphero.flavor.trd.5.opt1.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방벽 뒤로 몸을 숨긴다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take cover behind a barrier"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "障壁の陰に身を隠す"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "躲到屏障后方"
          }
        }
      }
    },
    "uphero.flavor.trd.5.opt1.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "별똥별이 잦아들 때까지 버텨냈다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
