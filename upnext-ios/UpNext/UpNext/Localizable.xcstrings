        }
      }
    },
    "uphero.flavor.wel.2.opt0.out1.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고양이가 앞길을 인도했다."
