        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "孪生之门——左门渗出光,右门泄出影。"
          }
        }
      }
    },
    "uphero.flavor.ntr.0.opt0.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먹어보기"
