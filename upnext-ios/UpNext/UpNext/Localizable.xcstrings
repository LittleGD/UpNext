    "uphero.flavor.ntr.5.opt0.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말린 고기와 곡식 — 오래됐지만 먹을 만하다."
