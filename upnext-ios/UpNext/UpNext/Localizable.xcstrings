    "uphero.flavor.ntr.4.opt0.out2.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진귀한 약버섯. 몸 안쪽이 따뜻해진다."
