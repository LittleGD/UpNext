    "던전에서 만난 몬스터·보스와 얻은 장비가 도감에 기록됩니다." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monsters and bosses you meet in the Dungeon, plus the gear you earn, get logged in your collection."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダンジョンで出会ったモンスター・ボスや手に入れた装備が図鑑に記録されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
