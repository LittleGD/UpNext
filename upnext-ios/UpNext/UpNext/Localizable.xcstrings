    "uphero.flavor.fit.3.opt1.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동굴에서 폭풍이 지나가길 기다렸다."
