    "uphero.flavor.ntr.3.opt0.out1.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "농부의 밭에서 큰 수확물을 얻었다."
