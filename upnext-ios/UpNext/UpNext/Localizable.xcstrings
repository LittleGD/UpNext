    "천 년 동안 한 마디도 않은 수행자. 그 침묵만으로 상처가 된다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An ascetic who has not spoken a single word in a thousand years. That silence alone wounds."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "千年ひと言も発さぬ修行者。その沈黙のみで傷となる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "千年未发一语的苦行者。仅其沉默便足以伤人。"
          }
        }
      }
    },
