    "uphero.flavor.fit.6.opt1.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "산양이 지나갈 때까지 숨을 죽였다."
