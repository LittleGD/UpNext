        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cat mewed and soothed the hero's heart."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "猫が鳴いて心を慰めてくれた。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "猫咪轻声呢喃,抚慰了心灵。"
