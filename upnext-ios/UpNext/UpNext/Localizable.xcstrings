    "uphero.flavor.fit.8.opt1.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사냥꾼은 웃으며 길을 알려 주었다."
