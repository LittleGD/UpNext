        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "坐在长苔的岩石上稍作休息"
          }
        }
      }
    },
    "uphero.rest.3": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바람이 잦은 은신처에 들었다"
