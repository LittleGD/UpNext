    },
    "uphero.flavor.trd.6.opt1.out2.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "균열의 끝자락에서 떨어진 시간 조각을 주웠다."
