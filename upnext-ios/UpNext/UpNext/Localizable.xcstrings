    },
    "uphero.flavor.uni.3.opt0.out1.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓴맛에 몸이 움찔. 효과는 희미했다."
