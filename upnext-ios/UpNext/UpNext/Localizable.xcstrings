      }
    },
    "uphero.flavor.wel.2.opt0.out2.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고양이가 변신! 수호 정령이었다."
