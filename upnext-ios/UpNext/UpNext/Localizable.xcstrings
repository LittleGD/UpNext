    "uphero.flavor.wel.2.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어둠 속에 고양이 한 마리. 눈빛이 따뜻하다."
