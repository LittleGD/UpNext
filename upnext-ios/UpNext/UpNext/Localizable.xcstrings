    },
    "uphero.flavor.fit.3.opt0.out1.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휘청이다가 잊혀진 가방에 부딪혔다."
