        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A bustling noise rose from the crowd."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "賑やかなる喧噪が響く。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "喧闹之声纷至沓来。"
          }
        }
      }
    },
    "uphero.narrative.soc.1": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "노래가 멀리서 울려 퍼진다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A song rang out in the distance."
