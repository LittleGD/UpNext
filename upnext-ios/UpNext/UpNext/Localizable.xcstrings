      }
    },
    "uphero.flavor.ntr.7.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창고지기가 신선한 과일 속에 상한 놈이 하나 섞였다고 한다."
