    "uphero.flavor.ntr.0.opt0.out2.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진귀한 약재였다. 몸이 튼튼해진다."
