      }
    },
    "uphero.flavor.trd.6.opt0.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신호가 바뀌는 순간 뛰어든다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dive through the moment the signal changes"
