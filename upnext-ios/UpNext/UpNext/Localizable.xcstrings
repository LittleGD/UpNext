    },
    "uphero.flavor.soc.3.opt0.out2.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "짧은 후렴구만 듣고 지나갔다."
