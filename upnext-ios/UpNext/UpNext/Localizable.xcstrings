    "uphero.flavor.fit.2.opt0.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고개를 숙인 뒤 금괴를 챙겼다."
