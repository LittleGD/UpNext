        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "流れ星がおさまるまで耐え抜いた。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一直撑到流星雨平息。"
          }
        }
      }
    },
    "uphero.flavor.trd.5.opt1.out1.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "방벽에 박힌 별 조각을 긁어냈다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You scraped off star fragments embedded in the barrier."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "障壁に突き刺さった星の欠片を削ぎ取った。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "刮下了嵌在屏障上的星之碎片。"
          }
        }
      }
    },
    "uphero.flavor.trd.5.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하늘이 찢기며 별똥별 소나기가 쏟아진다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sky tears open and a shower of shooting stars pours down."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空が引き裂かれ、流れ星のシャワーが降り注ぐ。"
