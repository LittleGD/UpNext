        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "商贩的招徕声不绝于耳。"
          }
        }
      }
    },
    "uphero.narrative.soc.3": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "군중이 영웅을 쳐다본다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The crowd turned and stared at the hero."
