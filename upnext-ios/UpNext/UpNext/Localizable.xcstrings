    "uphero.flavor.ntr.7.opt1.out1.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "멀쩡한 것까지 버려 낭비했다는 핀잔을 듣는다."
