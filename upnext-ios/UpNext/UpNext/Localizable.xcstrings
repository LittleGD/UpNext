    },
    "uphero.flavor.mnd.3.opt1.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지켜보기만 한다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only watch"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ただ見守る"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅驻足观望"
          }
