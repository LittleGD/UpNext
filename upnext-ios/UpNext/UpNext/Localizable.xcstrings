        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "傷んだ実を選び取ると、倉庫番が新鮮な果物の包みを添えてくれた。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你挑出坏果后,仓管又搭给你一包新鲜水果。"
