    "uphero.flavor.fit.7.opt1.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "낙석이 멈출 때까지 한참을 기다렸다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You waited a long while for the rockfall to stop."
