    "uphero.flavor.fit.8.opt1.out1.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사냥꾼이 건조육 한 조각을 내어 주었다."
