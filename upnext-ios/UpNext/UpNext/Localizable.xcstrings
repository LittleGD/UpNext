    },
    "uphero.flavor.ntr.7.opt0.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상한 열매를 골라내자 창고지기가 햇과일 꾸러미를 얹어준다."
          }
