    "uphero.flavor.ntr.8.opt0.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정확한 셈에 감탄한 농부가 수확물 한 아름을 나눠준다."
