      }
    },
    "uphero.flavor.fit.7.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "머리 위 절벽에서 돌덩이가 우수수 떨어진다!"
