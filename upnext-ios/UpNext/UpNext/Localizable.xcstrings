    "uphero.flavor.trd.6.opt1.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "균열은 사라졌지만 흐릿한 잔상만 남았다."
