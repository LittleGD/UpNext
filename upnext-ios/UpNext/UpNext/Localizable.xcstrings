    "내일을 연기하는 주문을 가진 시간의 파괴자.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A destroyer of time armed with the spell that postpones tomorrow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明日を延ばす呪を携えし、時の破壊者。"
