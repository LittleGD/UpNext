    "uphero.flavor.trd.6.opt0.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "완벽한 타이밍으로 균열을 통과해 시간의 보상을 거머쥐었다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With perfect timing you slipped through the rift and seized time's reward."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完璧なタイミングで裂け目を抜け、時の報酬を掴み取った。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以完美时机穿过裂隙,夺得了时间的馈赠。"
          }
        }
