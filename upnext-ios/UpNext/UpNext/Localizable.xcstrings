    },
    "uphero.flavor.fit.0.opt0.out2.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "절벽 아래 숨겨진 동전 더미를 발견했다!"
