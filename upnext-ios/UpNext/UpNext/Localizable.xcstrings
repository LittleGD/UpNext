    },
    "uphero.flavor.mst.7.opt1.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어둠 속에서 뜻밖의 보물을 찾았다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found unexpected treasure in the dark."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "闇の中で思わぬ宝を見つけた。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在黑暗中发现了意外的宝藏。"
          }
        }
      }
    },
    "uphero.flavor.mst.7.opt1.out1.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림자가 영웅의 기력을 삼켰다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shadow drained the hero's strength."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "影が勇者の気力を飲み込んだ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阴影吞噬了勇者的气力。"
          }
        }
      }
    },
    "uphero.flavor.mst.7.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쌍둥이 문. 왼쪽은 빛이, 오른쪽은 그림자가 새어 나온다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Twin doors. Light leaks from the left, shadow from the right."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "双子の扉。左から光が、右から影が漏れる。"
