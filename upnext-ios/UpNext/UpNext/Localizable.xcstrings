    "uphero.flavor.soc.6.opt0.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잔을 들고 영주의 신호를 기다린다..."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You raise your cup and wait for the lord's signal..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "杯を掲げ、領主の合図を待つ..."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "举起酒杯,等待领主的信号……"
          }
