          }
        }
      }
    },
    "갓생 견습생": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go-Getter Apprentice"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "理想の毎日 見習い"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "充实生活学徒"
          }
        }
      }
    },
    "준비 완료! 첫 카드 뽑으러 가요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All set! Let's go draw your first card."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "準備完了！最初のカードを引きに行きましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "准备就绪！去抽你的第一张卡牌吧。"
          }
        }
      }
    },
    "계속": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
