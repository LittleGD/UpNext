    "방패가 없어요, 오늘은 꼭 켜요": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No Shields — be sure to light it today"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シールドがありません。今日は必ずつけましょう"
          }
