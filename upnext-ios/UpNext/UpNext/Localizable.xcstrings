    },
    "uphero.flavor.fit.0.opt0.out1.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발을 헛디뎌 크게 부딪혔다."
