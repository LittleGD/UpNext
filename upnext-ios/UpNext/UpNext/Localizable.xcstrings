        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "沉沉入梦——身体彻底恢复。"
          }
        }
      }
    },
    "uphero.flavor.wel.3.opt0.out2.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "악몽을 꾸다 깨어났다."
