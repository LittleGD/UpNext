    "uphero.flavor.fit.0.opt0.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영웅이 도약해 절벽을 뛰어넘었다! 한 층 건너뛴다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The hero vaulted clear of the cliff! A floor was skipped."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "勇者は跳躍し崖を飛び越えた!1 階スキップ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "勇者纵身跃过悬崖!跳过一层。"
