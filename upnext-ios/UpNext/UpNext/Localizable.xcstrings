    "uphero.flavor.fit.4.opt1.out1.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "길이 더 길었다. 예상보다 오래 걸린다."
