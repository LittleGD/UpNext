    "기기 데이터가 사라지면 복구할 수 없어요. 로그인해서 클라우드에 안전하게 보관하세요.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your device data is lost, it can't be recovered. Sign in to keep it safe in the cloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末のデータが消えると復元できません。ログインしてクラウドに安全に保管しましょう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备数据丢失后无法恢复。登录后将数据安全地保存到云端吧。"
