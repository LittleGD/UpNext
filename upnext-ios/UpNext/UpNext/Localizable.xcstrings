          "stringUnit": {
            "state": "translated",
            "value": "花瓣缓缓飘落。"
          }
        }
      }
    },
    "uphero.rest.0": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모닥불을 발견했다"
