    },
    "uphero.flavor.mnd.3.opt1.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정적이 마음을 평온하게 한다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The stillness calmed the hero's mind."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "静寂が心を穏やかにする。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "寂静令心灵归于平和。"
          }
        }
      }
    },
    "uphero.flavor.mnd.3.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종소리가 울리는 오래된 사당을 발견했다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An old shrine rings with a distant bell."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鐘の音が響く古い祠を見つけた。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发现一座钟声回响的古老神祠。"
          }
        }
      }
    },
    "uphero.flavor.mnd.4.opt0.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "예"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yes"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はい"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是"
          }
        }
      }
    },
    "uphero.flavor.mnd.4.opt0.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진실이 드러난다. 보스의 위치를 알게 되었다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The truth revealed — the boss's location is known."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "真実が露わになる。ボスの位置を知った。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "真相浮现——已知晓首领的方位。"
          }
        }
      }
    },
    "uphero.flavor.mnd.4.opt0.out1.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진실의 무게가 영웅을 짓누른다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The weight of truth pressed down on the hero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "真実の重みが勇者を圧した。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "真相的重量压垮了勇者。"
          }
        }
      }
    },
    "uphero.flavor.mnd.4.opt1.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아니오"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いいえ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "否"
          }
        }
      }
    },
    "uphero.flavor.mnd.4.opt1.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거절하자 그림자가 사라지며 지혜를 남겼다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shadow vanished, leaving wisdom behind."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拒むと影は知恵を残して消えた。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拒绝之后,阴影消散,留下一缕智慧。"
          }
        }
      }
    },
    "uphero.flavor.mnd.4.opt1.out1.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림자가 떠나며 영혼을 다독였다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The shadow departed, soothing the hero's soul."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "影が去り際、魂を慰めた。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阴影离去,轻抚了勇者的灵魂。"
          }
        }
      }
    },
    "uphero.flavor.mnd.4.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림자가 말을 건다: 진실을 보고 싶은가?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A shadow speaks: do you wish to see the truth?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "影が語りかける — 真実を見たいか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阴影低语:想见真相吗?"
          }
        }
      }
    },
    "uphero.flavor.mnd.5.opt0.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호흡을 모은다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gather the breath"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "呼吸を整える"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "凝聚呼吸"
          }
        }
      }
    },
    "uphero.flavor.mnd.5.opt0.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "향불이 흔들린다..."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The incense flame wavers..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "香の火が揺らぐ..."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "香火微微摇曳……"
          }
        }
      }
    },
    "uphero.flavor.mnd.5.opt1.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "천천히 예만 올린다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offer a quiet bow"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "静かに一礼する"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缓缓行礼"
          }
        }
      }
    },
    "uphero.flavor.mnd.5.opt1.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정중한 예에 제단이 잔잔히 빛났다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At the reverent bow, the altar glowed softly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "丁重な礼に、祭壇が静かに光った。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恭敬一礼,祭坛泛起柔光。"
          }
        }
      }
    },
    "uphero.flavor.mnd.5.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "정화의 제단 앞. 향불 연기가 피어오른다. 숨을 깊이 모아 참아라."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before the purification altar, incense smoke rises. Gather your breath and hold it deep."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "浄化の祭壇の前。香炉の煙が立ちのぼる。息を深く集めて止めよ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "净化祭坛前,香烟袅袅升起。深聚呼吸,屏息静守。"
          }
        }
      }
    },
    "uphero.flavor.mnd.6.opt0.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선을 따라 그린다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trace the lines"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "線をたどる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "循线描摹"
          }
        }
      }
    },
    "uphero.flavor.mnd.6.opt0.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손끝이 문양을 따라간다..."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your fingertip follows the pattern..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指先が文様をなぞる..."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指尖沿着纹路而行……"
          }
        }
      }
    },
    "uphero.flavor.mnd.6.opt1.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "멀리서 묵상한다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meditate from afar"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遠くから黙想する"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远处默观"
          }
        }
      }
    },
    "uphero.flavor.mnd.6.opt1.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "멀리서 바라본 문양이 마음을 가라앉혔다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Viewed from afar, the pattern calmed your mind."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遠く眺めた文様が、心を鎮めた。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远望纹路,心绪渐趋平静。"
          }
        }
      }
    },
    "uphero.flavor.mnd.6.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "돌바닥 위에 새겨진 만다라. 영혼의 인도자가 정해진 순서로 선을 따르라 이른다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A mandala carved into the stone floor. The spirit guide bids you trace its lines in order."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "石の床に刻まれた曼荼羅。魂の導き手が、定められた順に線をたどれと告げる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "石地上刻着一幅曼陀罗。魂之引路人示意你按序循线。"
          }
        }
      }
    },
    "uphero.flavor.mnd.7.opt0.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경전을 읽는다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the scriptures"
