    "uphero.flavor.ntr.4.opt0.out1.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "환각 버섯이었다. 머리가 핑 돈다."
