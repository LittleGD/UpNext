    "uphero.flavor.trd.6.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시공의 균열이 열리기 직전, 신호가 점멸하기 시작한다."
