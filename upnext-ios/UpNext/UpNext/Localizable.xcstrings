    },
    "uphero.flavor.wel.3.opt0.out1.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깊이 잠들었다. 몸이 완전히 회복되었다."
