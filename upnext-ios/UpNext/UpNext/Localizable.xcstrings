    },
    "uphero.flavor.mnd.7.opt0.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "글귀가 눈앞에서 어우러진다..."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The verses weave together before your eyes..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文言が目の前で重なり合う..."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "字句在眼前交织相合……"
          }
        }
      }
    },
    "uphero.flavor.mnd.7.opt1.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "향만 피우고 떠난다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light incense and leave"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "香だけ焚いて去る"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只焚香后离去"
          }
        }
      }
    },
    "uphero.flavor.mnd.7.opt1.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 줄기 향이 선방을 감쌌다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A single thread of incense enveloped the zen chamber."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一筋の香りが禅房を包み込んだ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一缕香气萦绕禅房。"
          }
        }
      }
    },
    "uphero.flavor.mnd.7.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "경전 조각이 흩어진 선방. 같은 뜻을 가진 구절끼리 짝지어라."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A zen chamber strewn with scripture fragments. Pair the verses that share the same meaning."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "経文の断片が散らばる禅房。同じ意味を持つ一節同士を組み合わせよ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "禅房中经文残片散落。将同义之句两两成对。"
          }
        }
      }
    },
    "uphero.flavor.mst.0.opt0.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손을 대본다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch it"
