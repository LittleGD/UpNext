        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sound of spring water was peaceful."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "温泉の水音が穏やかに響く。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "温泉的水声宁静安详。"
          }
        }
      }
    },
    "uphero.narrative.wel.2": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "치유의 기운이 감돈다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A healing warmth lingered in the air."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "癒しの気配が辺りを漂う。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "疗愈的气息在空气中萦绕。"
          }
        }
      }
    },
    "uphero.narrative.wel.3": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부드러운 풀 위를 걷는다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The hero walked on soft grass."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "柔らかき草の上を歩む。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "脚下是柔软的青草。"
          }
        }
      }
    },
    "uphero.narrative.wel.4": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허브 향기가 짙어진다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The scent of herbs grew rich and deep."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "薬草の香がますます濃くなる。"
          }
        },
