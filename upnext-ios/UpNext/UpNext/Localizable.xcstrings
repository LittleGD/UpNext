    "uphero.flavor.trd.2.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바이럴 밈이 공간을 지배한다. 따라 웃어야 할까?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A viral meme fills the space. Should the hero laugh along?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バイラルミームが空間を支配する。釣られて笑うべきか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "病毒式梗图占据整个空间——该跟着笑吗?"
          }
        }
      }
    },
    "uphero.flavor.trd.3.opt0.label": {
      "extractionState": "manual",
