    "uphero.flavor.fit.5.opt0.out2.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "크레바스 바닥에서 고대 유물을 찾았다."
