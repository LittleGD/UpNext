    "uphero.flavor.lrn.9.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사서의 경고가 떠오른다. \"이 주문은 숨을 참고 외워야 한다.\""
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The librarian's warning echoes: \"This incantation must be recited while holding your breath.\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "司書の警告がよみがえる。「この呪文は息を止めて唱えねばならぬ。」"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想起图书管理员的警告:「这段咒文须屏息而诵。」"
          }
        }
      }
    },
    "uphero.flavor.mnd.0.opt0.label": {
