        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仪表盘闪烁着红光。"
          }
        }
      }
    },
    "uphero.narrative.soc.0": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시끌벅적한 소리가 들린다."
