    "로그라이크 챌린지 카드로\n매일 갓생을 시작하세요": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start your go-getter life every day\nwith roguelike Challenge cards"
          }
        },
        "ja": {
