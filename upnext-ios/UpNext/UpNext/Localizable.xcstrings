        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "歌声从远处飘来回响。"
          }
        }
      }
    },
    "uphero.narrative.soc.2": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상인의 호객 소리."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A merchant called out to passers-by."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "商人の呼び込みが聞こえる。"
