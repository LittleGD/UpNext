    },
    "수백 년 잉크 속에 갇힌 영혼. 만지면 종이처럼 바스라진다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A soul trapped in centuries of ink. At a touch it crumbles away like parchment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "幾百年の墨に囚われし魂。触れれば紙の如く朽ちゆく。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "困于数百年墨痕之中的魂灵。一触即如纸片般碎散。"
          }
        }
      }
    },
    "다음 죽음 1회 무효 (HP 50%).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
