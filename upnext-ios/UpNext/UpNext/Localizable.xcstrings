    },
    "uphero.flavor.fit.7.opt1.out1.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기다리는 사이 떨어진 바위에 가려진 수정을 주웠다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While waiting, you picked up a crystal hidden by a fallen rock."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "待っている間、落ちた岩に隠れていた水晶を拾った。"
