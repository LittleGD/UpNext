    },
    "uphero.flavor.soc.6.opt1.out1.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구석에서도 눈에 띄어 상인이 덤 음식을 건넸다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Even in the corner you catch a merchant's eye, and he slips you extra food."
