    "uphero.flavor.fit.8.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "산속 사냥꾼이 내기를 건다. 신호에 맞춰 활시위를 놓아라."
