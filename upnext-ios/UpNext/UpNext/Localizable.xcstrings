    },
    "uphero.rest.4": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "별빛이 스며드는 동굴에서 한숨 돌린다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The hero paused in a starlit cavern"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "星光降り注ぐ洞で一息つく"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "于洒满星光的洞穴中歇了口气"
          }
        }
      }
    },
    "uphero.rest.5": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "낮은 돌담 아래 등을 기댔다"
