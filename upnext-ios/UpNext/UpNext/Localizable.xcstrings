    "uphero.flavor.uni.4.opt0.out1.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시간을 써 돌봤지만 그저 사라졌다."
