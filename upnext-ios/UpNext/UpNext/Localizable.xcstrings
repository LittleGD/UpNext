          "stringUnit": {
            "state": "translated",
            "value": "岩の上に座る散策者が挨拶をしてくる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "石上小憩的行人向勇者打招呼。"
          }
        }
      }
    },
    "uphero.flavor.wel.5.opt0.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리를 쫓아간다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Follow the sound"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音を追う"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "循声而去"
          }
        }
      }
    },
    "uphero.flavor.wel.5.opt0.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 풍경 아래 한참을 멈춘다. 호흡이 잔잔해진다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused beneath a small chime. The breath slowed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さな風鈴の下で長く足を止める。呼吸が穏やかになる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在小小的风铃下伫立良久——呼吸渐趋平静。"
          }
        }
      }
    },
    "uphero.flavor.wel.5.opt0.out1.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리를 낸 자는 악기 장인. 작은 호루라기를 건넨다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An instrument maker — offered a tiny whistle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音の主は楽器職人。小さな笛を渡してくれた。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发声者是乐器匠人——赠予一只小口哨。"
          }
        }
      }
    },
    "uphero.flavor.wel.5.opt0.out2.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미궁의 환청이었다. 길을 잃을 뻔했다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A labyrinth's illusion. Nearly lost the way."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "迷宮の幻聴だった。道に迷いかけた。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原来是迷宫的幻听——险些迷路。"
          }
        }
      }
    },
    "uphero.flavor.wel.5.opt1.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무시하고 간다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ignore and move on"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無視して進む"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无视离去"
          }
        }
      }
    },
    "uphero.flavor.wel.5.opt1.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "소리가 점점 멀어진다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sound faded into the distance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音が次第に遠のいてゆく。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声音渐渐远去。"
          }
        }
      }
    },
    "uphero.flavor.wel.5.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "멀리서 풍경 소리가 들린다. 바람 따라 멜로디가 실려온다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A distant wind chime. A melody drifts on the breeze."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遠くから風鈴の音が聞こえる。風に乗って旋律が運ばれてくる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远处传来风铃之声——旋律随风飘来。"
          }
        }
      }
    },
    "uphero.flavor.wel.6.opt0.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숨을 참고 깊이 잠긴다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold breath, sink deep"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "息を止めて深く沈む"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "屏息,深潜入水"
          }
        }
      }
    },
    "uphero.flavor.wel.6.opt0.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뜨거운 수증기 속, 심장 박동이 느려진다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In the thick steam, your heartbeat slows to a whisper."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "立ちこめる湯気の中、鼓動が静かに穏やかになっていく。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蒸汽氤氲,心跳渐渐变得缓慢而平稳。"
          }
        }
      }
    },
    "uphero.flavor.wel.6.opt1.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발만 담그고 쉰다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soak just your feet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "足だけ浸して休む"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只泡脚稍作歇息"
          }
        }
      }
    },
    "uphero.flavor.wel.6.opt1.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "따끈한 물에 발을 담그니 피로가 풀린다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm water laps at your feet and the weariness drains away."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "温かい湯に足を浸すと、疲れがじんわりとほどけていく。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将双脚浸入温水,疲惫慢慢消散开来。"
          }
        }
      }
    },
    "uphero.flavor.wel.6.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뜨거운 온천수에 몸을 담근다. 숨을 참고 오래 머물 수 있을까."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You sink into the steaming hot spring. How long can you hold your breath below the surface?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "熱い温泉にそっと身を沈める。息を止めて、どれだけ長く潜っていられるだろうか。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将身体浸入滚烫的温泉,屏住呼吸,能在水下停留多久呢?"
          }
        }
      }
    },
    "uphero.flavor.wel.7.opt0.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "물방울을 피해 건넌다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodge the drops and cross"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "雫をかわして渡る"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "躲开水珠过桥"
          }
        }
      }
    },
    "uphero.flavor.wel.7.opt0.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "증기 사이로 물방울이 쏟아진다. 몸을 비틀어 피한다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drops lance through the steam; you twist and weave between them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "湯気の中を雫が降り注ぐ。身をひねってかわしていく。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "水珠穿过蒸汽砸下,你侧身闪避穿行其间。"
          }
        }
      }
    },
    "uphero.flavor.wel.7.opt1.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "우회로로 돌아간다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take the long way around"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遠回りをする"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绕远路而行"
          }
        }
      }
    },
    "uphero.flavor.wel.7.opt1.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼 길이지만 마른 돌을 밟으며 걷는다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The path is longer, but every stone underfoot is dry."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遠回りだが、乾いた石を踏みしめて歩いていく。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "路虽远,但脚下皆是干燥的岩石。"
          }
        }
      }
    },
    "uphero.flavor.wel.7.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "젖은 이끼 돌다리. 위에서 뜨거운 물방울이 뚝뚝 떨어진다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A moss-slicked stone bridge — scalding droplets plink down from above."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "苔に覆われた濡れた石橋。頭上から熱い雫がぽたぽたと落ちてくる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "布满湿苔的石桥上方,滚烫的水珠正一滴滴落下。"
          }
        }
      }
    },
    "uphero.flavor.wel.8.opt0.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상한 잎을 골라낸다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick out the spoiled leaf"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "傷んだ葉を選り分ける"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "挑出腐坏的叶子"
          }
        }
      }
    },
    "uphero.flavor.wel.8.opt0.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잎맥을 하나하나 살핀다. 어디가 달랐을까."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You trace each vein, searching for the one that isn't like the others."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "葉脈を一本ずつ確かめていく。どこが違っていたのだろう。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一根根查看叶脉,究竟哪一片与众不同。"
          }
        }
      }
    },
    "uphero.flavor.wel.8.opt1.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전부 달여 먹는다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brew them all together"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全部まとめて煎じる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一起煎煮服下"
          }
        }
      }
    },
    "uphero.flavor.wel.8.opt1.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓴맛이 돌지만 그럭저럭 몸을 덥혀준다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's bitter, but the warmth seeps in all the same."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "苦みが口に広がるが、それでも体をじんわり温めてくれる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "苦涩入喉,却也让身子暖和起来。"
          }
        }
      }
    },
    "uphero.flavor.wel.8.opt1.out1.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상한 잎이 배를 뒤집었다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rotten leaf turns your stomach inside out."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "傷んだ葉のせいで胃がひっくり返るように痛む。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "腐坏的叶子让你肠胃翻腾。"
          }
        }
      }
    },
    "uphero.flavor.wel.8.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약초꾼이 나란히 놓은 약초 더미. 한 줌 속에 상한 잎이 섞여 있다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An herbalist has laid out bundles of healing leaves — one hides a rotten one."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "薬草採りが並べた薬草の束。その中に傷んだ葉が一枚まぎれている。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "采药人摆放的一摞草药中,夹杂着一片腐坏的叶子。"
          }
        }
      }
    },
    "uphero.narrative.fit.0": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차가운 바람이 바위 사이를 휘감는다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A cold wind wound between the rocks."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "冷たき風が岩間を縫って吹き抜けた。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "冷风在岩石间穿梭盘绕。"
          }
        }
      }
    },
    "uphero.narrative.fit.1": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발 아래 돌이 흩어진다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stones scattered beneath the hero's feet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "足下の小石が砕け散った。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "脚下的碎石四散滚落。"
          }
        }
      }
    },
    "uphero.narrative.fit.2": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "멀리서 늑대 울음이 들린다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A wolf's howl carried from far away."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遠くから狼の遠吠えが届く。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远方传来狼嗥之声。"
          }
        }
      }
    },
    "uphero.narrative.fit.3": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가파른 절벽을 올라간다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The hero climbed the sheer cliff face."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "切り立った崖を登り続ける。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "勇者攀登陡峭的崖壁。"
          }
        }
      }
    },
    "uphero.narrative.fit.4": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "눈보라가 시야를 가린다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A blizzard veiled the path ahead."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "吹雪が視界を覆い隠す。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暴风雪遮蔽了视线。"
          }
        }
      }
    },
    "uphero.narrative.fit.5": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "산악 새가 울며 지나간다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A mountain bird cried out and flew past."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "山鳥が鳴きながら通り過ぎる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "山鸟鸣叫着掠过。"
          }
        }
      }
    },
    "uphero.narrative.fit.6": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오래된 사람의 흔적을 발견한다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Old footprints marked the trail."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古き人の足跡を見つけた。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发现了古老的人迹。"
          }
        }
      }
    },
    "uphero.narrative.fit.7": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "얼어붙은 폭포 옆을 지난다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The hero passed a frozen waterfall."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "凍り付いた滝の脇を過ぎる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经过一道结冰的瀑布。"
          }
        }
      }
    },
    "uphero.narrative.fit.8": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숨을 고르며 앞으로 나아간다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The hero caught their breath and pressed on."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "息を整えつつ歩を進める。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "勇者调整呼吸,继续前行。"
          }
        }
      }
    },
    "uphero.narrative.fit.9": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발자국 소리가 골짜기에 울린다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Footsteps echoed through the valley."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "足音が谷間に響き渡る。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "脚步声在山谷间回响。"
          }
        }
      }
    },
    "uphero.narrative.lrn.0": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼지 쌓인 책장이 끝없이 이어진다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dust-covered shelves stretched on without end."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "塵積もりし書架が果てしなく続く。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "积尘的书架无尽延伸。"
          }
        }
      }
    },
    "uphero.narrative.lrn.1": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "촛불이 흔들리며 그림자를 만든다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A candle guttered, throwing long shadows."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "蝋燭が揺れ、影を描き出す。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "烛火摇曳,映出长影。"
          }
        }
      }
    },
    "uphero.narrative.lrn.2": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고대 문서의 향이 코를 찌른다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The scent of ancient parchment stung the air."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古文書の香が鼻を突く。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "古卷的气息扑鼻而来。"
          }
        }
      }
    },
    "uphero.narrative.lrn.3": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조용한 속삭임이 들린다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A quiet whisper drifted from somewhere nearby."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "静かなる囁きが聞こえる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "细微的低语声若有若无。"
          }
        }
      }
    },
    "uphero.narrative.lrn.4": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "책 한 권이 스스로 넘어간다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A book turned its own page."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一冊の本がひとりでに頁をめくる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一本书自行翻过了一页。"
          }
        }
      }
    },
    "uphero.narrative.lrn.5": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잉크 냄새가 진해진다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The smell of ink grew heavy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "墨の匂いが濃く立ち込める。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "墨香愈发浓郁。"
          }
        }
      }
    },
    "uphero.narrative.lrn.6": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어둠 속에서 눈동자가 반짝인다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eyes glinted somewhere in the dark."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "闇の中で瞳が光った。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "黑暗中有眸光一闪。"
          }
        }
      }
    },
    "uphero.narrative.lrn.7": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "종이 부스러기가 발걸음마다 밟힌다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scraps of paper crunched underfoot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "紙屑が歩むたび足下で音を立てる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纸屑随脚步碎裂作响。"
          }
        }
      }
    },
    "uphero.narrative.lrn.8": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "천장 높이 쌓인 책이 위태롭다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Books stacked to the ceiling leaned precariously."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "天井まで積まれし書物が危うく揺れる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "堆至天花板的书籍摇摇欲坠。"
          }
        }
      }
    },
    "uphero.narrative.lrn.9": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "멀리서 종이 울린다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A distant bell tolled once."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "遠くにて鐘が響いた。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "远处传来一声钟响。"
          }
        }
      }
    },
    "uphero.narrative.mnd.0": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고요가 귓속을 채운다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A deep silence filled the hero's ears."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "静寂が耳の奥を満たす。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "静寂填满了耳畔。"
          }
        }
      }
    },
    "uphero.narrative.mnd.1": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "향 냄새가 부드럽게 스민다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The scent of incense drifted softly in."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "香の匂いが柔らかに染み込む。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "檀香柔和地弥漫开来。"
          }
        }
      }
    },
    "uphero.narrative.mnd.2": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "호흡 소리만이 들린다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the sound of breathing remained."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "息遣いの音だけが残る。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "唯余呼吸之声。"
          }
        }
      }
    },
    "uphero.narrative.mnd.3": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빛 한 줄기가 바닥을 비춘다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A single beam of light struck the floor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一条の光が床を照らす。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一缕光照在地面之上。"
          }
        }
      }
    },
    "uphero.narrative.mnd.4": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마음이 잔잔해진다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The hero's heart grew still."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "心が静かに鎮まっていく。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "心境渐趋平静。"
          }
        }
      }
    },
    "uphero.narrative.mnd.5": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 종소리가 맑게 퍼진다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A small bell rang clear and bright."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さき鈴の音が清く広がる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "小小的铃声清澈回荡。"
          }
        }
      }
    },
    "uphero.narrative.mnd.6": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "눈을 감았다 뜨자 주변이 바뀌었다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The hero blinked, and the room had changed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "瞬きの間に周囲が変わっておる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "眨眼之间,周遭已变。"
          }
        }
      }
    },
    "uphero.narrative.mnd.7": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "영혼의 기운이 느껴진다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A presence of spirit hung in the air."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "魂の気配を感ずる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐约感到灵魂的气息。"
          }
        }
      }
    },
    "uphero.narrative.mnd.8": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무언가가 지켜보는 듯하다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something seemed to be watching."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何者かに見られている気がする。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "似乎有什么在暗中窥视。"
          }
        }
      }
    },
    "uphero.narrative.mnd.9": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공기가 무겁게 눌러온다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The air pressed down, heavy and close."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空気が重く圧しかかる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空气沉重地压迫而来。"
          }
        }
      }
    },
    "uphero.narrative.ntr.0": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "황금빛 곡물이 바람에 흔들린다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Golden grain swayed in the wind."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "黄金色の穀物が風に揺れる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "金黄色的谷物随风摇曳。"
          }
        }
      }
    },
    "uphero.narrative.ntr.1": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "풍성한 과일 향이 퍼진다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The scent of ripe fruit filled the air."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "豊かな果物の香が辺りに広がる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "丰盛的果香四溢。"
          }
        }
      }
    },
    "uphero.narrative.ntr.2": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꿀벌이 주위를 맴돈다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A honeybee circled the hero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "蜜蜂が周りを旋回する。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蜜蜂在身旁盘旋。"
          }
        }
      }
    },
    "uphero.narrative.ntr.3": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "익은 토마토가 발에 채인다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A ripe tomato rolled under the hero's boot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "熟れた実が足下に転がる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "熟透的果实被踢到脚下。"
          }
        }
      }
    },
    "uphero.narrative.ntr.4": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "곡식 창고의 문이 삐걱인다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The door of a grain barn creaked on its hinge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "穀物倉の扉が軋みを立てた。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "谷仓的门吱呀作响。"
          }
        }
      }
    },
    "uphero.narrative.ntr.5": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허수아비가 우뚝 서 있다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A scarecrow stood tall against the sky."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "案山子が空にすくと立っておる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稻草人笔直地伫立。"
          }
        }
      }
    },
    "uphero.narrative.ntr.6": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "태양이 따뜻하게 내리쬔다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sun beat down warm and slow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "陽光が暖かく降り注ぐ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阳光温暖地照耀下来。"
          }
        }
      }
    },
    "uphero.narrative.ntr.7": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "채소밭 너머 무엇인가 움직인다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Something moved beyond the vegetable rows."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "菜園の向こうで何者かが動いた。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜园那头似有什么在动。"
          }
        }
      }
    },
    "uphero.narrative.ntr.8": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잘 익은 열매가 길을 막는다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A heavy, ripe fruit blocked the path."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よく熟れた実が道を塞ぐ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "熟透的果实挡住了去路。"
          }
        }
      }
    },
    "uphero.narrative.ntr.9": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "농부의 흔적이 보인다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Traces of a farmer lingered on the soil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "農夫の足跡が見える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看见了农夫留下的足迹。"
          }
        }
      }
    },
    "uphero.narrative.prd.0": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "톱니바퀴 소리가 일정하게 들린다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gears whirred in a steady rhythm."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "歯車の音が一定に刻まれる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "齿轮之声稳定规律。"
          }
        }
      }
    },
    "uphero.narrative.prd.1": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시계 초침이 멈췄다 다시 간다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A clock's hand froze, then ticked on."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "秒針が止まり、また動き出す。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "秒针停顿后又继续走动。"
          }
        }
      }
    },
    "uphero.narrative.prd.2": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기계 증기가 뿜어져 나온다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam hissed from a ruptured pipe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "機械から蒸気が噴き出す。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "机器喷出阵阵蒸汽。"
          }
        }
      }
    },
    "uphero.narrative.prd.3": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "황동 파이프가 복잡하게 얽혔다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brass pipes wound into a tangled knot."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "真鍮の管が複雑に絡み合う。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "黄铜管道错综交织。"
          }
        }
      }
    },
    "uphero.narrative.prd.4": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진자가 규칙적으로 흔들린다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A pendulum swung in measured arcs."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "振り子が規則正しく揺れる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摆锤有节奏地摇晃。"
          }
        }
      }
    },
    "uphero.narrative.prd.5": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공간이 뒤틀린 듯 느껴진다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The space seemed to bend slightly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空間が歪んだように感ずる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "空间仿佛有些扭曲。"
          }
        }
      }
    },
    "uphero.narrative.prd.6": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메트로놈 소리가 심장과 맞춰진다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A metronome clicked in time with the hero's heart."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メトロノームが鼓動と合わさる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "节拍器之声与心跳合拍。"
          }
        }
      }
    },
    "uphero.narrative.prd.7": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기계 팔이 반복 작동한다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A mechanical arm repeated its task."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "機械腕が反復の動作を続ける。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "机械臂重复着作业。"
          }
        }
      }
    },
    "uphero.narrative.prd.8": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시계탑 종이 울린다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The clocktower bell struck a deep tone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時計塔の鐘が荘厳に響く。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钟塔的大钟庄严鸣响。"
          }
        }
      }
    },
    "uphero.narrative.prd.9": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계기판이 붉게 깜빡인다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A gauge blinked a warning red."
