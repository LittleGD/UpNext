    "uphero.flavor.trd.6.opt1.out1.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잔잔한 시간의 결을 느끼며 회복되었다."
