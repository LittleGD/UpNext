        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "人群齐齐望向勇者。"
          }
        }
      }
    },
    "uphero.narrative.soc.4": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누군가 말을 걸려 한다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Someone was about to speak."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰かが声をかけようとする。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有人似要开口搭话。"
          }
        }
      }
    },
    "uphero.narrative.soc.5": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "술잔 부딪히는 소리."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cups clinked together somewhere nearby."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "酒杯を打ち合わせる音がする。"
          }
