      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공중에 떠 있는 화면에 알 수 없는 슬로건이 번쩍거린다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A floating screen flashes a cryptic slogan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "宙に浮かぶ画面に得体の知れないスローガンが明滅する。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "悬浮空中的屏幕上闪烁着看不懂的标语。"
          }
        }
      }
    },
    "uphero.flavor.trd.2.opt0.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "함께 웃기"
