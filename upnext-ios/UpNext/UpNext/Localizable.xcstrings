{
  "sourceLanguage": "ko",
  "strings": {
    "'%@' 을(를) 완료로 표시할까요?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark '%@' as complete?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を完了にしますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将「%@」标记为完成吗？"
          }
        }
      }
    },
