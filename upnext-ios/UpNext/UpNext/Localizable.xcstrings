    "uphero.flavor.lrn.8.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "천장이 열리며 밤하늘이 드러난다. 별자리를 이어 그려 길을 열어라."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ceiling parts to reveal the night sky. Trace the constellation to open the way."
          }
