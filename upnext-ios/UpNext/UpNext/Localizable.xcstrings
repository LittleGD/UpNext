      }
    },
    "uphero.flavor.soc.6.opt1.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "뒷자리에서 조용히 마신다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drink quietly in the back"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "後ろの席で静かに飲む"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在后排安静地小酌"
          }
        }
      }
    },
    "uphero.flavor.soc.6.opt1.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주목받지 않고 편히 한 잔 비웠다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You finish a cup in peace, unnoticed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "注目を浴びずに一杯を空けた。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不被人注意,悠然饮尽一杯。"
