    "uphero.flavor.ntr.5.opt0.out2.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "누군가 숨겨둔 보물함이 같이 있었다."
