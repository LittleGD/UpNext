    "uphero.flavor.soc.4.opt0.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수풀 속에서 인형을 찾아주었다. 아이의 웃음이 번진다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Found the doll in the bushes. The child's smile spread."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "茂みの中から人形を見つけた。子の笑顔が広がる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在草丛里找回了玩偶。孩子露出笑容。"
          }
        }
      }
    },
    "uphero.flavor.soc.4.opt0.out1.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아이의 부모가 감사해하며 말린 꽃을 쥐여준다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The grateful parents pressed dried flowers into the hero's hand."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "子の両親が感謝し、押し花を握らせてくれた。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "孩子的父母感激地递来一束干花。"
          }
        }
      }
    },
    "uphero.flavor.soc.4.opt0.out2.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수풀 너머로 뛰쳐나온 들개에게 물렸다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A wild dog burst from the bushes and bit the hero."
