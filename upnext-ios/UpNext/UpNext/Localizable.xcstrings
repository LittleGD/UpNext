    "겨울잠을 건너온 돌산의 왕. 한 걸음에 길이 갈라진다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A stone-mountain king that strode through winter's sleep. Paths split beneath its every step."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
