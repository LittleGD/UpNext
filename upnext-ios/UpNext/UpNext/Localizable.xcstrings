            "state": "translated",
            "value": "放弃前的最后一次。"
          }
        }
      }
    },
    "질문을 거부한 자에게 내려지는 저주의 화신.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The incarnation of the curse that falls upon those who refuse to ask questions."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問いを拒んだ者に下される呪いの化身。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "降于拒绝发问者之上的诅咒化身。"
          }
        }
      }
    },
    "작은 석상": {
      "extractionState": "manual",
      "localizations": {
