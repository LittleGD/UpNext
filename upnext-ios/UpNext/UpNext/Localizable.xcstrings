        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "靠在低矮的石墙下"
          }
        }
      }
    },
    "uphero.rest.6": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오래된 여행자 표식 옆에서 쉰다"
