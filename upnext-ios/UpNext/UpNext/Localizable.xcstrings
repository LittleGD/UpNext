          "stringUnit": {
            "state": "translated",
            "value": "草药的芬芳愈加浓郁。"
          }
        }
      }
    },
    "uphero.narrative.wel.5": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작은 시냇물이 흐른다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A small stream trickled past."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さな小川が静かに流れる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一条小溪潺潺流过。"
          }
        }
      }
    },
    "uphero.narrative.wel.6": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수정같은 물이 고였다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Crystal-clear water pooled nearby."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水晶の如き水が溜まっておる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "水晶般的清水汇成一泓。"
          }
        }
      }
    },
    "uphero.narrative.wel.7": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무언가 졸음이 온다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A drowsy warmth began to settle in."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "心地よき眠気が差し込んでくる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一阵睡意悄然袭来。"
          }
        }
      }
    },
    "uphero.narrative.wel.8": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온화한 빛이 감싼다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A gentle light wrapped around the hero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "穏やかな光が勇者を包む。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "温和的光芒将勇者包围。"
          }
        }
      }
    },
    "uphero.narrative.wel.9": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "꽃잎이 천천히 떨어진다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Petals fell slowly through the still air."
