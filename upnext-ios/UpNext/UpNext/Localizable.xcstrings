    "uphero.flavor.mnd.1.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기억의 연못. 물결 위에 떠오른 그림자가 흐려진다. 같은 쌍을 찾아라."
