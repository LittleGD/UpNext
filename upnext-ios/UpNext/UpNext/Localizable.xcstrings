    "uphero.flavor.fit.1.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "절벽 위 흔들다리. 리듬에 맞춰 건너야 떨어지지 않는다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A rope bridge sways over the cliff. Match its rhythm or fall."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "崖上の吊り橋。リズムを合わせねば落下する。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "悬崖上的吊桥。必须踩准节奏才不会坠落。"
          }
        }
      }
    },
    "uphero.flavor.fit.2.opt0.label": {
      "extractionState": "manual",
