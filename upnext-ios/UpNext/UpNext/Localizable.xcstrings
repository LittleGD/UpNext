    },
    "uphero.flavor.mst.4.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "희미한 목소리가 선택을 제안한다 — 하나를 바친다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A faint voice offers a bargain — give up one thing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "微かな声が選択を迫る — 一つを捧げよ。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "幽微的声音提出交易——献上一样东西。"
          }
        }
      }
    },
    "uphero.flavor.mst.5.opt0.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깃털을 줍는다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick up the feather"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "羽根を拾う"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拾起羽毛"
          }
        }
      }
    },
    "uphero.flavor.mst.5.opt0.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바람의 축복 — 다음 층까지 한걸음에."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A blessing of wind — the hero advanced one floor."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "風の祝福 — 次の階まで一歩で。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "风的祝福——一步直抵下一层。"
          }
        }
      }
    },
    "uphero.flavor.mst.5.opt0.out1.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깃털이 재가 되며 손을 그슬린다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The feather crumbled to ash, searing the hand."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "羽根が灰となり、手を焦がす。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "羽毛化为灰烬,灼伤了手掌。"
          }
        }
      }
    },
    "uphero.flavor.mst.5.opt0.out2.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새가 돌아와 영웅 곁에 머문다 — 보물 발견."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bird returned and stayed near the hero — treasure found."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鳥が戻り勇者に寄り添う — 宝を発見。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "鸟儿归来停在勇者身旁——发现宝物。"
          }
        }
      }
    },
    "uphero.flavor.mst.5.opt1.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남긴 채 지나간다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave it behind"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残して通り過ぎる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留下不拾"
          }
        }
      }
    },
    "uphero.flavor.mst.5.opt1.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자연의 몫은 자연에 남긴다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What belongs to nature, stays with nature."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自然のものは自然に残す。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "属于自然之物,归还于自然。"
          }
        }
      }
    },
    "uphero.flavor.mst.5.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검은 깃털이 떨어진 자리. 새가 한 번 울고 사라진다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A black feather drifts down. A bird cries once and is gone."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "黒い羽根が落ちた場所。鳥が一声鳴いて消えた。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "黑色羽毛落下的地方——鸟鸣一声,随即消失。"
          }
        }
      }
    },
    "uphero.flavor.mst.6.opt0.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름을 새겨본다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Carve a name"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名を刻んでみる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尝试刻上名字"
          }
        }
      }
    },
    "uphero.flavor.mst.6.opt0.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름이 빛나며 기록된 공덕이 영웅에게 돌아온다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The name glowed — recorded deeds returned to the hero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名が輝き、記された徳が勇者に返される。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名字发出光辉——所记功德回流至勇者。"
          }
        }
      }
    },
    "uphero.flavor.mst.6.opt0.out1.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지워진 존재가 깨어나 비난한다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The erased one awoke and condemned the hero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "消された存在が目覚めて糾弾する。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被抹除的存在苏醒并发出指责。"
          }
        }
      }
    },
    "uphero.flavor.mst.6.opt0.out2.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비석이 무너지고 지도가 드러난다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The stone crumbled, revealing a map."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "石碑が崩れ、地図が現れた。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "石碑崩塌,地图现形。"
          }
        }
      }
    },
    "uphero.flavor.mst.6.opt1.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "묵념만 한다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand in silence"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "黙祷のみ捧げる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "默哀片刻"
          }
        }
      }
    },
    "uphero.flavor.mst.6.opt1.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잊혀진 이름을 잠시 생각한다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused to remember a forgotten name."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "忘れられた名をしばし想う。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为被遗忘的名字驻足片刻。"
          }
        }
      }
    },
    "uphero.flavor.mst.6.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름이 지워진 비석. 누군가를 기억하지 않는다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A gravestone with the name erased. No one is remembered."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名を削られた石碑。誰も記憶されていない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一块名字被磨去的石碑——无人再记得此人。"
          }
        }
      }
    },
    "uphero.flavor.mst.7.opt0.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "빛의 문으로 들어간다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the door of light"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "光の扉に入る"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "步入光之门"
          }
        }
      }
    },
    "uphero.flavor.mst.7.opt0.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "따뜻한 빛이 영웅을 휘감는다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Warm light enveloped the hero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "温かな光が勇者を包む。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "温暖的光芒缠绕勇者全身。"
          }
        }
      }
    },
    "uphero.flavor.mst.7.opt0.out1.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "너무 밝아 눈이 멀 뻔했다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So bright it nearly blinded the hero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "眩しすぎて目が眩みそうだった。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "光太刺眼——险些失明。"
          }
        }
      }
    },
    "uphero.flavor.mst.7.opt1.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그림자의 문으로 들어간다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the door of shadow"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "影の扉に入る"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "步入影之门"
