        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一緒に笑う"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一起笑"
          }
        }
      }
    },
    "uphero.flavor.trd.2.opt0.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기분 전환. 에너지가 돈다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A mood boost — energy flowed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "気分転換。エネルギーが巡る。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "心情一振——能量流转起来。"
          }
        }
      }
    },
    "uphero.flavor.trd.2.opt0.out1.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "억지 웃음으로 혼란스러워진다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forced laughter left the hero confused."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作り笑いで混乱してきた。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "强笑过后,反倒一阵恍惚。"
          }
        }
      }
    },
    "uphero.flavor.trd.2.opt0.out2.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "진심 어린 웃음이 공간을 물들였다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Genuine laughter colored the whole space."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "心からの笑いが空間を染めた。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "真挚的笑声染亮了整个空间。"
          }
        }
      }
    },
    "uphero.flavor.trd.2.opt1.label": {
      "extractionState": "manual",
      "localizations": {
