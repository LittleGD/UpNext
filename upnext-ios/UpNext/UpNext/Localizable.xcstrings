    "uphero.flavor.ntr.7.opt1.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "창고지기가 아까워하며 자투리 몇 개만 건넸다."
