    },
    "uphero.flavor.wel.4.opt0.out1.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "산책자가 길을 지름길로 알려준다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The hiker pointed out a shortcut."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "散策者が近道を教えてくれた。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "行人告知了一条捷径。"
          }
        }
      }
    },
    "uphero.flavor.wel.4.opt0.out2.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사실은 늙은 현자였다. 조언이 폐부를 스친다."
