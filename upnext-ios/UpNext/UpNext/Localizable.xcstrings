      }
    },
    "uphero.flavor.fit.3.opt0.out2.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이를 악물고 버틴 영웅이 성장했다."
