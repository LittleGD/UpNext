    "uphero.flavor.uni.4.opt0.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동물이 고마워하며 숨겨진 보물을 안내했다."
