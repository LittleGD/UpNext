    "uphero.flavor.soc.5.opt0.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오래된 여행자의 조언이 담겨 있다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It held advice from an old traveler."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古き旅人の助言が記されていた。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "里头写着一位老旅行者的建议。"
          }
        }
      }
    },
    "uphero.flavor.soc.5.opt0.out1.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지도 단편. 다음 길이 또렷해진다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A map fragment — the path ahead grows clearer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "地図の断片。次の道が鮮明になる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "是地图残片——接下来的路线清晰了。"
          }
        }
      }
    },
    "uphero.flavor.soc.5.opt0.out2.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저주받은 서신. 마음이 무거워진다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A cursed letter. The heart grew heavy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "呪いの書簡。心が重くなる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "竟是被诅咒的信件——心头变得沉重。"
          }
        }
      }
    },
    "uphero.flavor.soc.5.opt1.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손대지 않는다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave it untouched"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "触れない"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不去触碰"
          }
        }
      }
    },
    "uphero.flavor.soc.5.opt1.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남의 사연은 남의 것으로 남긴다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Left another's story to another."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他人の事情は他人のものに残す。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "他人的故事,便让它留在他人手中。"
          }
        }
      }
    },
    "uphero.flavor.soc.5.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "돌 틈에 봉인도 없는 낡은 편지가 꽂혀 있다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An unsealed old letter is wedged between stones."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "石の隙間に封もない古びた手紙が挟まっている。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "石缝中夹着一封没有封印的旧信。"
          }
        }
      }
    },
    "uphero.flavor.soc.6.opt0.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "타이밍 맞춰 건배"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toast on cue"
