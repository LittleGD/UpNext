            "state": "translated",
            "value": "浓雾之灵"
          }
        }
      }
    },
    "누구도 읽지 않는 책의 저자. 자신의 이름을 되찾기 위해 싸운다.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The author of a book no one reads. It fights to reclaim its own name."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰にも読まれぬ書の著者。自らの名を取り戻すために戦う。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无人读之书的著者。为夺回己名而战。"
          }
        }
      }
    },
    "시계 병사": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Clock Soldier"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時計の兵士"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钟表卫兵"
          }
        }
      }
    },
    "뽑히지 않기 위해 이빨을 만든 어린 풀.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A young sprout that grew teeth to keep from being pulled up."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "抜かれまいと牙を生やしし若草。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为不被拔起而生出利齿的幼草。"
          }
        }
      }
    },
    "다음 3 round 공격 +25%.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attack +25% for 3 rounds."
          }
