    "uphero.flavor.fit.7.opt0.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발끝에 집중하고 리듬을 읽는다..."
          }
