        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "洞窟で嵐が過ぎるのを待った。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在洞穴中等风暴过去。"
          }
        }
      }
    },
    "uphero.flavor.fit.3.opt1.out1.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동굴 구석에서 오래된 동전 주머니를 발견했다."
