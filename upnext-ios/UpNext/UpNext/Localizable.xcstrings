    "uphero.flavor.ntr.5.opt1.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지나친다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Walk past"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通り過ぎる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "绕过"
          }
        }
      }
    },
    "uphero.flavor.ntr.5.opt1.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "남의 물건엔 손대지 않는다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another's goods are not to be touched."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他人の物には手を出さない。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "他人之物,不去碰。"
          }
        }
      }
    },
    "uphero.flavor.ntr.5.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "버려진 저장고의 자물쇠가 헐거워 보인다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An abandoned storehouse sits with a loose lock."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "打ち捨てられた貯蔵庫の錠が緩んで見える。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "废弃仓库的锁看起来松动了。"
          }
        }
      }
    },
    "uphero.flavor.ntr.6.opt0.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 바구니에 빠르게 나눈다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sort them into two baskets, fast"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "二つのかごに素早く分ける"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快速分到两个篮子里"
          }
        }
      }
    },
    "uphero.flavor.ntr.6.opt0.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "깔끔히 나눠담자 상인이 햇과일 한 바구니를 건넸다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You sort them cleanly and the vendor hands over a basket of fresh fruit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "きれいに分けると、商人が新鮮な果物一かごをくれた。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你分得干净利落,商人递给你一篮新鲜水果。"
          }
        }
      }
    },
    "uphero.flavor.ntr.6.opt1.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대충 섞어서 돌려준다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hand it back haphazardly"
