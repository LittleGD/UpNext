    },
    "uphero.flavor.mst.0.opt0.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "표식이 뜨거워지며 힘이 스며든다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The mark warmed — power seeped in."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "紋章が熱を帯び、力が染み込んでくる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "符号发烫,力量渗入体内。"
          }
        }
      }
    },
    "uphero.flavor.mst.0.opt0.out1.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "손끝이 얼어붙는다. 대가가 크다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fingertips froze. A heavy cost."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指先が凍りつく。代償は大きい。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指尖冻结——代价不小。"
          }
        }
      }
    },
    "uphero.flavor.mst.0.opt0.out2.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잊혀진 보관함이 열린다!"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A forgotten vault swung open!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "忘れられた保管庫が開いた!"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一只被遗忘的保险匣打开了!"
          }
