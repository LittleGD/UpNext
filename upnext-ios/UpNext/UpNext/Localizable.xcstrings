        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原来是位老贤者——箴言直入肺腑。"
          }
        }
      }
    },
    "uphero.flavor.wel.4.opt1.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "눈인사만 건넨다"
