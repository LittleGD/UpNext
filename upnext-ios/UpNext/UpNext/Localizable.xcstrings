        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The hero sat on a moss-covered stone to rest"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "苔むす岩に腰を下ろし、しばし休む"
