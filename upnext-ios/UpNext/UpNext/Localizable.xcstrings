        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "適当に混ぜて返す"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随手混着还回去"
          }
        }
      }
    },
    "uphero.flavor.ntr.6.opt1.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "상인이 한숨을 쉬며 약간의 동전만 쥐어준다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The vendor sighs and gives you only a few coins."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "商人はため息をつき、小銭だけを握らせた。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "商人叹了口气,只给了几枚铜钱。"
          }
        }
      }
    },
    "uphero.flavor.ntr.6.opt1.out1.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "성난 상인이 썩은 무를 던졌다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The angry vendor hurls a rotten radish at you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "怒った商人が腐った大根を投げつけた。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恼怒的商人朝你扔来一颗烂萝卜。"
          }
        }
      }
    },
    "uphero.flavor.ntr.6.prompt": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "장터 상인이 농산물과 잡동사니가 뒤섞였다며 분류를 부탁한다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A market vendor asks you to sort produce mixed in with random supplies."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "市場の商人が農産物と雑貨が混ざってしまったと仕分けを頼んでくる。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "集市商人请你帮忙把混在一起的农产品和杂物分开。"
          }
        }
      }
    },
    "uphero.flavor.ntr.7.opt0.label": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한눈에 찾아낸다"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spot it at a glance"
