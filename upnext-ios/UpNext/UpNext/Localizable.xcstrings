      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete Account (can’t be undone)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント削除（取り消せません）"
