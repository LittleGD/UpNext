    "uphero.flavor.wel.4.opt0.out0.result": {
      "extractionState": "manual",
      "localizations": {
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숨을 나누며 마음이 가벼워진다."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sharing a breath lightened the heart."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "息を分かち合い、心が軽くなる。"
